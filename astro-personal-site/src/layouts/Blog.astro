---
import type { MarkdownLayoutProps } from "astro";
import Main from "./Main.astro";

type Props = MarkdownLayoutProps<{
  // Define frontmatter props here
  title: string;
  poster: string;
  subtitle: string;
}>;
console.log("Astro.props:", Astro.props); // Add this line
// get properties from the markdown frontmatter
const { poster, title, subtitle } = Astro.props.frontmatter;
console.log("Astro.props.frontmatter:", Astro.props.frontmatter); // Add this line
---

<Main title="Frau Katerina | Blog">
    <figure class="figure">
        <img src={poster} alt="" width="100%" height="480px" class="figure__image" />
        <figcaption>
            Poster image for {title}
        </figcaption>
    </figure>
    <h1>{title}</h1>
    <h2>{subtitle}</h2>
    <p>{title}</p>
    <slot />
</Main>